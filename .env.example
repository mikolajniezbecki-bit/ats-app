# Environment for `pnpm dev` (tech-stack.md §3). Copy to `.env` and fill the
# empty secret values; see README "Configuration" for where they come from.
# Never commit `.env`.

# Database
DATABASE_URL=
# Azure db-migrate job only; db:migrate falls back to DATABASE_URL
DATABASE_ADMIN_URL=

# Authentication (AU1, AU7)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Codespaces only: the forwarded-port proxy rewrites Origin to localhost:3000.
# Read by Better Auth itself, not getConfig(); never set it in Azure.
# BETTER_AUTH_TRUSTED_ORIGINS=https://localhost:3000,http://localhost:3000
# Microsoft Entra ID: all three or none; required when APP_ENV=azure
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
# local, ci or azure; never inferred from other variables
APP_ENV=local
# Dev sign-in; refused with APP_ENV=azure or EMAIL_PROVIDER=outbox
AUTH_DEV_LOGIN=true
# Seeded demo users (dev sign-in only; password at least 12 characters)
DEMO_USER_PASSWORD=
DEMO_USER_DOMAIN=ats-demo.local
# db-seed job only: promote this email to Admin instead of seeding
SEED_ADMIN_EMAIL=

# Email (smtp = Mailpit locally; outbox is required in Azure)
EMAIL_HASH_KEY=
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# File storage: a connection string (Azurite), or account URL + client ID
# (managed identity, Azure). The connection string wins when both are set.
AZURE_STORAGE_CONNECTION_STRING=
# Optional browser-facing Azurite endpoint; defaults to the connection string's
AZURE_STORAGE_PUBLIC_URL=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_CLIENT_ID=

# CAPTCHA (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Background jobs
TICK_SECRET=
WORKER_ENABLED=true

# Logging: info in Azure, debug locally
LOG_LEVEL=debug
