{
  "name": "ats-app",
  "version": "0.1.0",
  "private": true,
  "author": "Mikołaj Niezbecki",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=parallel; parallel=$?; playwright test --project=time-travel; timetravel=$?; [ $parallel -eq 0 ] && [ $timetravel -eq 0 ]",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules",
    "test:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/check-rules.ts",
    "db:generate": "drizzle-kit generate",
    "db:build": "node src/server/db/build-migrate.mjs",
    "db:migrate": "node src/server/db/build-migrate.mjs && node --env-file-if-exists=.env dist/db/migrate.mjs",
    "db:seed": "node src/server/db/build-migrate.mjs && node --env-file-if-exists=.env dist/db/seed.mjs",
    "seed:admin": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/server/db/seed-admin-cli.ts",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/worker/index.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@react-pdf/renderer": "^4.9.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.12",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "unpdf": "^1.9.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
