{
  "name": "ats-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules",
    "test:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/check-rules.ts",
    "db:generate": "drizzle-kit generate",
    "db:build": "node src/server/db/build-migrate.mjs",
    "db:migrate": "node src/server/db/build-migrate.mjs && node --env-file-if-exists=.env dist/db/migrate.mjs",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/worker/index.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "better-auth": "^1.7.12",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
