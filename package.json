{
  "name": "ats-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules",
    "test:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/check-rules.ts"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
